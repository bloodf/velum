-- #113: collapse duplicate device-session library rows, then unique-index.
-- Re-downloads before this fix left multiple rows per session_id; CREATE UNIQUE
-- INDEX alone would crash those databases.
-- Orphan audio files for dropped rows are not deleted here (SQL cannot unlink
-- files). Tracked as a follow-up — do not claim a startup sweep from this
-- migration (would overlap #86 PartialRecordingRecovery / VelumApplication).

-- Keeper per session_id: prefer non-trashed, then rows with transcript/summary,
-- then oldest created_at, then lowest id.
CREATE TEMP TABLE _session_keep AS
SELECT r.session_id AS session_id, r.id AS keep_id
FROM recording AS r
WHERE r.session_id IS NOT NULL
  AND r.id = (
    SELECT r2.id FROM recording AS r2
    WHERE r2.session_id = r.session_id
    ORDER BY
      CASE WHEN r2.trashed = 0 THEN 0 ELSE 1 END,
      CASE
        WHEN (r2.transcript IS NOT NULL AND length(r2.transcript) > 0)
          OR (r2.summary_markdown IS NOT NULL AND length(r2.summary_markdown) > 0)
        THEN 0 ELSE 1
      END,
      r2.created_at ASC,
      r2.id ASC
    LIMIT 1
  );

-- Row whose transcript the keeper will end up with (keeper if it already has
-- one; otherwise the oldest sibling that has a transcript).
CREATE TEMP TABLE _transcript_source AS
SELECT
  k.session_id AS session_id,
  k.keep_id AS keep_id,
  CASE
    WHEN (keeper.transcript IS NOT NULL AND length(keeper.transcript) > 0)
      THEN k.keep_id
    ELSE (
      SELECT d.id FROM recording AS d
      WHERE d.session_id = k.session_id
        AND d.transcript IS NOT NULL
        AND length(d.transcript) > 0
      ORDER BY d.created_at ASC, d.id ASC
      LIMIT 1
    )
  END AS source_id
FROM _session_keep AS k
INNER JOIN recording AS keeper ON keeper.id = k.keep_id;

-- Keeper's own active summary_version before re-point (preferred survivor).
CREATE TEMP TABLE _keeper_had_active AS
SELECT k.keep_id AS keep_id, v.id AS ver_id
FROM _session_keep AS k
INNER JOIN summary_version AS v
  ON v.recording_id = k.keep_id AND v.is_active = 1;

-- Merge transcript that exists only on a duplicate onto the keeper.
UPDATE recording
SET transcript = (
  SELECT d.transcript FROM recording AS d
  WHERE d.session_id = recording.session_id
    AND d.transcript IS NOT NULL
    AND length(d.transcript) > 0
  ORDER BY d.created_at ASC, d.id ASC
  LIMIT 1
)
WHERE id IN (SELECT keep_id FROM _session_keep)
  AND (transcript IS NULL OR length(transcript) = 0);

UPDATE recording
SET summary_markdown = (
  SELECT d.summary_markdown FROM recording AS d
  WHERE d.session_id = recording.session_id
    AND d.summary_markdown IS NOT NULL
    AND length(d.summary_markdown) > 0
  ORDER BY d.created_at ASC, d.id ASC
  LIMIT 1
)
WHERE id IN (SELECT keep_id FROM _session_keep)
  AND (summary_markdown IS NULL OR length(summary_markdown) = 0);

-- Prefer a folder link from any sibling if the keeper has none.
UPDATE recording
SET folder_id = (
  SELECT d.folder_id FROM recording AS d
  WHERE d.session_id = recording.session_id
    AND d.folder_id IS NOT NULL
    AND length(d.folder_id) > 0
  ORDER BY d.created_at ASC, d.id ASC
  LIMIT 1
)
WHERE id IN (SELECT keep_id FROM _session_keep)
  AND (folder_id IS NULL OR length(folder_id) = 0);

-- Speakers: keep only those from the transcript source row; drop the rest of
-- the session group's speakers (including the keeper's if it was not the source).
DELETE FROM speaker
WHERE recording_id IN (
  SELECT d.id FROM recording AS d
  INNER JOIN _session_keep AS k ON k.session_id = d.session_id
  LEFT JOIN _transcript_source AS t ON t.session_id = d.session_id
  WHERE d.id != COALESCE(t.source_id, k.keep_id)
);

UPDATE speaker
SET recording_id = (
  SELECT t.keep_id FROM _transcript_source AS t
  WHERE t.source_id = speaker.recording_id
)
WHERE recording_id IN (
  SELECT t.source_id FROM _transcript_source AS t
  WHERE t.source_id IS NOT NULL AND t.source_id != t.keep_id
);

-- Re-point summary versions from dropped rows onto the keeper.
UPDATE summary_version
SET recording_id = (
  SELECT k.keep_id FROM _session_keep AS k
  INNER JOIN recording AS d ON d.session_id = k.session_id
  WHERE d.id = summary_version.recording_id
)
WHERE recording_id IN (
  SELECT d.id FROM recording AS d
  INNER JOIN _session_keep AS k ON k.session_id = d.session_id
  WHERE d.id != k.keep_id
);

-- Exactly one active summary_version per keeper.
UPDATE summary_version
SET is_active = 0
WHERE recording_id IN (SELECT keep_id FROM _session_keep);

UPDATE summary_version
SET is_active = 1
WHERE id IN (SELECT ver_id FROM _keeper_had_active);

UPDATE summary_version
SET is_active = 1
WHERE id IN (
  SELECT v.id FROM summary_version AS v
  WHERE v.recording_id IN (SELECT keep_id FROM _session_keep)
    AND NOT EXISTS (
      SELECT 1 FROM summary_version AS a
      WHERE a.recording_id = v.recording_id AND a.is_active = 1
    )
    AND v.id = (
      SELECT v2.id FROM summary_version AS v2
      WHERE v2.recording_id = v.recording_id
      ORDER BY v2.created_at DESC, v2.id DESC
      LIMIT 1
    )
);

DELETE FROM recording
WHERE session_id IS NOT NULL
  AND id NOT IN (SELECT keep_id FROM _session_keep);

DROP TABLE _keeper_had_active;
DROP TABLE _transcript_source;
DROP TABLE _session_keep;

CREATE UNIQUE INDEX IF NOT EXISTS recording_device_session_unique ON recording(session_id)
WHERE session_id IS NOT NULL;
