CREATE TABLE folder (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  created_at INTEGER NOT NULL
);

CREATE TABLE recording (
  id TEXT NOT NULL PRIMARY KEY,
  session_id INTEGER,
  folder_id TEXT,
  title TEXT NOT NULL,
  source TEXT NOT NULL DEFAULT 'local',
  device_serial TEXT,
  started_at INTEGER NOT NULL,
  duration_seconds INTEGER NOT NULL DEFAULT 0,
  size_bytes INTEGER NOT NULL DEFAULT 0,
  local_path TEXT,
  transcript TEXT,
  summary_markdown TEXT,
  status TEXT NOT NULL DEFAULT 'ready',
  trashed INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL
);

CREATE TABLE speaker (
  id TEXT NOT NULL PRIMARY KEY,
  recording_id TEXT NOT NULL,
  label TEXT NOT NULL,
  display_name TEXT,
  talk_seconds INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE template (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  category TEXT NOT NULL,
  description TEXT NOT NULL,
  author TEXT NOT NULL DEFAULT 'Velum',
  system_prompt TEXT NOT NULL,
  uses INTEGER NOT NULL DEFAULT 0,
  builtin INTEGER NOT NULL DEFAULT 1,
  created_at INTEGER NOT NULL,
  featured INTEGER NOT NULL DEFAULT 1,
  tags TEXT NOT NULL DEFAULT '',
  lang TEXT NOT NULL DEFAULT 'und',
  preferred_model TEXT,
  preferred_endpoint_profile_id TEXT
);

CREATE TABLE autoflow (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  enabled INTEGER NOT NULL DEFAULT 1,
  wake_phrase TEXT,
  duration_min_seconds INTEGER NOT NULL DEFAULT 0,
  duration_max_seconds INTEGER NOT NULL DEFAULT 10800,
  source_filter TEXT NOT NULL DEFAULT 'all',
  template_id TEXT,
  auto_label_voice INTEGER NOT NULL DEFAULT 0,
  language TEXT NOT NULL DEFAULT 'auto',
  notify INTEGER NOT NULL DEFAULT 1,
  post_action TEXT,
  model_id TEXT,
  endpoint_profile_id TEXT
);

CREATE TABLE memory_item (
  id TEXT NOT NULL PRIMARY KEY,
  content TEXT NOT NULL,
  created_at INTEGER NOT NULL
);

CREATE TABLE glossary_term (
  id TEXT NOT NULL PRIMARY KEY,
  term TEXT NOT NULL,
  definition TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL
);

CREATE TABLE app_meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE summary_version (
  id TEXT NOT NULL PRIMARY KEY,
  recording_id TEXT NOT NULL,
  template_id TEXT,
  template_name TEXT NOT NULL DEFAULT '',
  markdown TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  is_active INTEGER NOT NULL DEFAULT 0
);

selectAllRecordings:
SELECT * FROM recording WHERE trashed = 0 ORDER BY started_at DESC;

selectTrashedRecordings:
SELECT * FROM recording WHERE trashed = 1 ORDER BY started_at DESC;

selectRecordingById:
SELECT * FROM recording WHERE id = ?;

insertRecording:
INSERT OR REPLACE INTO recording(
  id, session_id, folder_id, title, source, device_serial, started_at,
  duration_seconds, size_bytes, local_path, transcript, summary_markdown, status, trashed, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRecordingTitle:
UPDATE recording SET title = ? WHERE id = ?;

updateTranscript:
UPDATE recording SET transcript = ? WHERE id = ?;

updateSummary:
UPDATE recording SET summary_markdown = ? WHERE id = ?;

updateStatus:
UPDATE recording SET status = ? WHERE id = ?;

updateLocalPath:
UPDATE recording SET local_path = ?, duration_seconds = ?, size_bytes = ? WHERE id = ?;

updateProcessingCheckpoint:
UPDATE recording SET status = ?, transcript = ?, summary_markdown = ? WHERE id = ?;

trashRecording:
UPDATE recording SET trashed = 1 WHERE id = ?;

restoreRecording:
UPDATE recording SET trashed = 0 WHERE id = ?;

deleteRecordingHard:
DELETE FROM recording WHERE id = ?;

updateRecordingFolder:
UPDATE recording SET folder_id = ? WHERE id = ?;

selectSpeakersForRecording:
SELECT * FROM speaker WHERE recording_id = ? ORDER BY label ASC;

insertSpeaker:
INSERT OR REPLACE INTO speaker(id, recording_id, label, display_name, talk_seconds)
VALUES (?, ?, ?, ?, ?);

updateSpeakerDisplayName:
UPDATE speaker SET display_name = ? WHERE id = ?;

deleteSpeakersForRecording:
DELETE FROM speaker WHERE recording_id = ?;

selectTemplateById:
SELECT * FROM template WHERE id = ?;

countRecordings:
SELECT COUNT(*) FROM recording WHERE trashed = 0;

selectAllFolders:
SELECT * FROM folder ORDER BY name ASC;

insertFolder:
INSERT OR REPLACE INTO folder(id, name, created_at) VALUES (?, ?, ?);

selectTemplates:
SELECT * FROM template ORDER BY category ASC, name ASC;

selectTemplatesByCategory:
SELECT * FROM template WHERE category = ? ORDER BY name ASC;

selectFeaturedBuiltinTemplates:
SELECT * FROM template WHERE builtin = 1 AND featured = 1 ORDER BY category ASC, name ASC;

selectAllBuiltinTemplates:
SELECT * FROM template WHERE builtin = 1 ORDER BY category ASC, name ASC;

insertTemplate:
INSERT OR REPLACE INTO template(
  id, name, category, description, author, system_prompt, uses, builtin, created_at,
  featured, tags, lang, preferred_model, preferred_endpoint_profile_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTemplate:
DELETE FROM template WHERE id = ? AND builtin = 0;

deleteTemplateHard:
DELETE FROM template WHERE id = ?;

deleteAllBuiltinTemplates:
DELETE FROM template WHERE builtin = 1;

deleteAllCustomTemplates:
DELETE FROM template WHERE builtin = 0;

deleteAllAutoflows:
DELETE FROM autoflow;

deleteAllMemories:
DELETE FROM memory_item;

deleteAllGlossary:
DELETE FROM glossary_term;

selectAllRecordingIds:
SELECT id FROM recording;

selectAutoflows:
SELECT * FROM autoflow ORDER BY name ASC;

insertAutoflow:
INSERT OR REPLACE INTO autoflow(
  id, name, enabled, wake_phrase, duration_min_seconds, duration_max_seconds,
  source_filter, template_id, auto_label_voice, language, notify, post_action,
  model_id, endpoint_profile_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAutoflowEnabled:
UPDATE autoflow SET enabled = ? WHERE id = ?;

updateAutoflow:
UPDATE autoflow SET
  name = ?,
  enabled = ?,
  wake_phrase = ?,
  duration_min_seconds = ?,
  duration_max_seconds = ?,
  source_filter = ?,
  template_id = ?,
  auto_label_voice = ?,
  language = ?,
  notify = ?,
  post_action = ?,
  model_id = ?,
  endpoint_profile_id = ?
WHERE id = ?;

updateAutoflowNotify:
UPDATE autoflow SET notify = ? WHERE id = ?;

deleteAutoflow:
DELETE FROM autoflow WHERE id = ?;

selectMemories:
SELECT * FROM memory_item ORDER BY created_at DESC;

insertMemory:
INSERT OR REPLACE INTO memory_item(id, content, created_at) VALUES (?, ?, ?);

deleteMemory:
DELETE FROM memory_item WHERE id = ?;

selectGlossary:
SELECT * FROM glossary_term ORDER BY term COLLATE NOCASE ASC;

insertGlossary:
INSERT OR REPLACE INTO glossary_term(id, term, definition, created_at) VALUES (?, ?, ?, ?);

deleteGlossary:
DELETE FROM glossary_term WHERE id = ?;

getMeta:
SELECT value FROM app_meta WHERE key = ?;

setMeta:
INSERT OR REPLACE INTO app_meta(key, value) VALUES (?, ?);

selectVersionsForRecording:
SELECT * FROM summary_version WHERE recording_id = ? ORDER BY created_at DESC;

insertSummaryVersion:
INSERT OR REPLACE INTO summary_version(
  id, recording_id, template_id, template_name, markdown, created_at, is_active
) VALUES (?, ?, ?, ?, ?, ?, ?);

clearActiveVersionsForRecording:
UPDATE summary_version SET is_active = 0 WHERE recording_id = ?;

setVersionActive:
UPDATE summary_version SET is_active = 1 WHERE id = ? AND recording_id = ?;

deleteSummaryVersion:
DELETE FROM summary_version WHERE id = ? AND recording_id = ?;

getActiveVersion:
SELECT * FROM summary_version WHERE recording_id = ? AND is_active = 1 LIMIT 1;

getSummaryVersionById:
SELECT * FROM summary_version WHERE id = ? AND recording_id = ?;

countVersionsForRecording:
SELECT COUNT(*) FROM summary_version WHERE recording_id = ?;

deleteVersionsForRecording:
DELETE FROM summary_version WHERE recording_id = ?;
