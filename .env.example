# Example only — never commit real keys.
# Velum stores API keys in platform secure storage, not in env files by default.
# VELUM_AI_BASE_URL=https://api.openai.com/v1
# VELUM_AI_API_KEY=
# OAuth client IDs (leave unset to show Blocked status in Integrations):
# VELUM_GOOGLE_CALENDAR_CLIENT_ID=
# VELUM_GOOGLE_CALENDAR_REDIRECT_URI=dev.velum.app:/oauth2redirect
