--- a/libarchive/archive_read_support_format_zip.c
+++ b/libarchive/archive_read_support_format_zip.c
@@ -685,0 +686,31 @@
+/* Velum: validate raw ZIP names before libarchive converts or terminates them. */
+static int
+velum_zip_name(struct archive_read *a, const char *p, size_t n)
+{
+ size_t i, start = 0;
+ if (n == 0 || p[0] == '/') goto unsafe;
+ for (i = 0; i <= n; ++i) {
+  if (i < n && (p[i] == 0 || p[i] == '\\' || p[i] == ':')) goto unsafe;
+  if (i == n || p[i] == '/') {
+   if (i - start == 2 && p[start] == '.' && p[start + 1] == '.') goto unsafe;
+   start = i + 1;
+  }
+ }
+ return ARCHIVE_OK;
+unsafe:
+ archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Unsafe raw ZIP path");
+ return ARCHIVE_FATAL;
+}
+
+/* Reject raw Unix types before FIFO and trailing-slash normalization. */
+static int
+velum_zip_type(struct archive_read *a, unsigned int mode)
+{
+ unsigned int type = mode & AE_IFMT;
+ if (type == 0 || type == AE_IFREG || type == AE_IFDIR)
+  return ARCHIVE_OK;
+ archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+     "ZIP special file metadata is forbidden");
+ return ARCHIVE_FATAL;
+}
+
